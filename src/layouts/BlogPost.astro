---
import type { CollectionEntry } from "astro:content";
import mathStyles from "@/styles/math.css?url";
import paperStyles from "@/styles/paper.css?url";
import { formatPaperPages } from "@/utils/paper";
import BaseLayout from "./Base.astro";
interface Props {
  post:
    | CollectionEntry<"post">
    | CollectionEntry<"project">
    | CollectionEntry<"note">;
}
const { post } = Astro.props;
// The Markdown loader can log a rendering error and retain an entry without HTML.
if (post.filePath?.endsWith(".md") && !post.rendered) {
  throw new Error(
    `Could not render ${post.collection}/${post.id}. Fix Markdown or LaTeX errors before building.`,
  );
}
const {
  title,
  description,
  publishDate,
  authors,
  format,
  abstract,
  affiliation,
  pdf,
  numberedSections,
  columns,
} = post.data;
const unlisted = "unlisted" in post.data && post.data.unlisted;
const updatedDate =
  "updatedDate" in post.data ? post.data.updatedDate : undefined;
const ogImage = "ogImage" in post.data ? post.data.ogImage : undefined;
const kind = "kind" in post.data ? post.data.kind : "blog";
const backLink =
  kind === "research"
    ? "/research/"
    : kind === "art"
      ? "/art/"
      : kind === "project"
        ? "/projects/"
        : "/blog/";
const backLabel =
  kind === "research"
    ? "Research"
    : kind === "art"
      ? "Art"
      : kind === "project"
        ? "Projects"
        : "Blog";
const articleDate = publishDate.toISOString();
const pages = formatPaperPages(
  await Astro.slots.render("default"),
  numberedSections,
  columns,
);
const hasMath = pages.some((content) => /class="[^"]*\bkatex\b/.test(content));
---

<BaseLayout
  meta={{
    articleDate,
    description: description ?? "",
    ogImage,
    title,
    noindex: unlisted,
  }}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={paperStyles} data-paper-styles />
    {hasMath && <link rel="stylesheet" href={mathStyles} data-math-styles />}
  </Fragment>
  <article
    class:list={[
      "paper",
      "paper-editorial",
      {
        "paper-manuscript": format === "paper",
        "paper-reading": columns === 1,
      },
    ]}
    data-pagefind-body={!unlisted || undefined}
    data-pagefind-ignore={unlisted || undefined}
  >
    <div class="article-topline mono">
      <a href={backLink}>← {backLabel}</a>
      <span
        >{format === "paper" ? "Paper" : "Article"}{
          pages.length > 1 && ` · ${pages.length} pages`
        }</span
      >
    </div>
    <div class="paper-sheets">
      {
        pages.map((content, index) => (
          <section
            class="paper-page"
            id={`paper-page-${index + 1}`}
            aria-label={`Page ${index + 1} of ${pages.length}`}
          >
            <div class="paper-page-content">
              {index === 0 ? (
                <header
                  class:list={[
                    "article-heading",
                    {
                      "article-heading-split":
                        columns === 2 && !!(abstract || description),
                    },
                  ]}
                >
                  <div class="article-title-block">
                    <h1>{title}</h1>
                    <p class="article-byline">
                      <span>{authors.join(" · ")}</span>
                      <span aria-hidden="true">·</span>
                      <time datetime={articleDate}>
                        {publishDate.toLocaleDateString("en-GB", {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                          timeZone: "UTC",
                        })}
                      </time>
                    </p>
                    {affiliation && (
                      <p class="article-affiliation">{affiliation}</p>
                    )}
                    {pdf && (
                      <a class="paper-pdf" href={pdf}>
                        Download PDF ↓
                      </a>
                    )}
                    {updatedDate && (
                      <p class="eyebrow">
                        Updated{" "}
                        <time datetime={updatedDate.toISOString()}>
                          {updatedDate.toLocaleDateString("en-GB", {
                            day: "numeric",
                            month: "long",
                            year: "numeric",
                            timeZone: "UTC",
                          })}
                        </time>
                      </p>
                    )}
                  </div>
                  {(abstract || description) && (
                    <div class="article-summary">
                      {abstract ? (
                        <p class="article-abstract">
                          <strong>Abstract.</strong> {abstract}
                        </p>
                      ) : (
                        <p class="article-description">{description}</p>
                      )}
                    </div>
                  )}
                </header>
              ) : (
                <div class="paper-running" aria-hidden="true">
                  <span>{title}</span>
                  <span>{format === "paper" ? "Paper" : "Article"}</span>
                </div>
              )}
              <div class="prose article-prose" set:html={content} />
            </div>
            <div class="paper-page-number" aria-hidden="true">
              {index + 1} / {pages.length}
            </div>
          </section>
        ))
      }
    </div>
  </article>
  <div class="article-bottom mono">
    <a href={backLink}>← Back to {backLabel.toLowerCase()}</a><a href="#main"
      >Back to top ↑</a
    >
  </div>
</BaseLayout>
