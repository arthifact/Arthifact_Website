---
import type { CollectionEntry } from "astro:content";
import mathStyles from "@/styles/math.css?url";
import BaseLayout from "./Base.astro";
interface Props {
  post:
    | CollectionEntry<"post">
    | CollectionEntry<"project">
    | CollectionEntry<"note">;
}
const { post } = Astro.props;
// The Markdown loader can log a rendering error and retain an entry without HTML.
if (post.filePath?.endsWith(".md") && !post.rendered) {
  throw new Error(
    `Could not render ${post.collection}/${post.id}. Fix Markdown or LaTeX errors before building.`,
  );
}
const { title, description, publishDate, authors } = post.data;
const updatedDate =
  "updatedDate" in post.data ? post.data.updatedDate : undefined;
const ogImage = "ogImage" in post.data ? post.data.ogImage : undefined;
const kind = "kind" in post.data ? post.data.kind : "blog";
const backLink =
  kind === "research"
    ? "/research/"
    : kind === "art"
      ? "/art/"
      : kind === "project"
        ? "/projects/"
        : "/blog/";
const backLabel =
  kind === "research"
    ? "Research"
    : kind === "art"
      ? "Art"
      : kind === "project"
        ? "Projects"
        : "Blog";
const articleDate = publishDate.toISOString();
const content = await Astro.slots.render("default");
const hasMath = /class="[^"]*\bkatex\b/.test(content);
---

<BaseLayout
  meta={{
    articleDate,
    description: description ?? "",
    ogImage,
    title,
    noindex: "unlisted" in post.data && post.data.unlisted,
  }}
>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href={mathStyles} data-math-styles />}
  </Fragment>
  <article
    class="paper"
    data-pagefind-body={!("unlisted" in post.data && post.data.unlisted) ||
      undefined}
  >
    <div class="article-topline mono">
      <a href={backLink}>← {backLabel}</a>
    </div>
    <header class="article-heading">
      <h1>{title}</h1>
      <p class="article-byline">
        <span>{authors.join(" · ")}</span><span aria-hidden="true">
          ·
        </span><time datetime={articleDate}
          >{
            publishDate.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
              timeZone: "UTC",
            })
          }</time
        >
      </p>{description && <p class="article-description">{description}</p>}{
        updatedDate && (
          <p class="eyebrow">
            Updated{" "}
            <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
                timeZone: "UTC",
              })}
            </time>
          </p>
        )
      }
    </header>
    <div class="prose article-prose" set:html={content} />
  </article>
  <div class="article-bottom mono">
    <a href={backLink}>← Back to {backLabel.toLowerCase()}</a><a href="#main"
      >Back to top ↑</a
    >
  </div>
</BaseLayout>
