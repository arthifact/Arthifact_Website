---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./Base.astro";
interface Props {
  post:
    | CollectionEntry<"post">
    | CollectionEntry<"project">
    | CollectionEntry<"note">;
}
const { post } = Astro.props;
const { title, description, publishDate } = post.data;
const updatedDate =
  "updatedDate" in post.data ? post.data.updatedDate : undefined;
const coverImage = "coverImage" in post.data ? post.data.coverImage : undefined;
const ogImage = "ogImage" in post.data ? post.data.ogImage : undefined;
const kind = "kind" in post.data ? post.data.kind : "blog";
const backLink =
  kind === "research"
    ? "/research/"
    : kind === "art"
      ? "/art/"
      : kind === "project"
        ? "/projects/"
        : "/blog/";
const backLabel =
  kind === "research"
    ? "Research"
    : kind === "art"
      ? "Art"
      : kind === "project"
        ? "Projects"
        : "Blog";
const articleDate = publishDate.toISOString();
const { headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  meta={{
    articleDate,
    description: description ?? "",
    ogImage,
    title,
    noindex: "unlisted" in post.data && post.data.unlisted,
  }}
>
  <article
    data-pagefind-body={!("unlisted" in post.data && post.data.unlisted) ||
      undefined}
  >
    <div class="article-topline mono">
      <a href={backLink}>← {backLabel}</a><span>Gabriel I. Alonso</span>
    </div>
    <header class="article-heading">
      <p class="eyebrow">
        {
          kind === "research"
            ? "Research essay"
            : kind === "art"
              ? "Art & animation"
              : kind
        } / <time datetime={articleDate}
          >{
            publishDate.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
              timeZone: "UTC",
            })
          }</time
        >
      </p><h1>{title}</h1><p class="article-description">{description}</p>{
        updatedDate && (
          <p class="eyebrow">
            Updated{" "}
            {updatedDate.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
              timeZone: "UTC",
            })}
          </p>
        )
      }{
        coverImage && (
          <div class="article-cover">
            <Image
              src={coverImage.src}
              alt={coverImage.alt}
              widths={[640, 960, 1440]}
              sizes="(max-width: 960px) 100vw, 920px"
              width={960}
              format="webp"
              quality={82}
              loading="eager"
            />
          </div>
        )
      }
    </header>
    <div class="article-layout">
      <div class="prose article-prose"><slot /></div>{
        toc.length > 0 && (
          <details class="article-toc" open>
            <>
              <summary>On this page</summary>
              <nav aria-label="Table of contents">
                <ol>
                  {toc.map((heading) => (
                    <li data-depth={heading.depth}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </>
          </details>
        )
      }
    </div>
  </article>
  <div class="article-bottom mono">
    <a href={backLink}>← Back to {backLabel.toLowerCase()}</a><a href="#main"
      >Back to top ↑</a
    >
  </div>
</BaseLayout>
