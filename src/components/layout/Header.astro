---
import { getEntry } from "astro:content";
import { menuLinks } from "@/site.config";
const pathname = Astro.url.pathname;
let activePath = pathname;
if (pathname.startsWith("/projects/") && pathname !== "/projects/") {
  const project = await getEntry(
    "project",
    pathname.slice("/projects/".length).replace(/\/$/, ""),
  );
  if (project?.data.kind === "research") activePath = "/research/";
  if (project?.data.kind === "art") activePath = "/art/";
}
if (pathname.startsWith("/notes/")) activePath = "/blog/";
---

<header class="site-header" data-pagefind-ignore>
  <a class="wordmark" href="/" aria-label="Gabriel I. Alonso — home"
    >G. I. Alonso<span class="wordmark-dot" aria-hidden="true">.</span></a
  >
  <nav aria-label="Main navigation" class="main-nav">
    {
      menuLinks.map((link) => (
        <a
          href={link.path}
          aria-current={
            activePath.startsWith(link.path) ||
            (link.path === "/blog/" && pathname.startsWith("/posts/"))
              ? "page"
              : undefined
          }
        >
          {link.title}
        </a>
      ))
    }
  </nav>
  <a class="header-cv mono" href="/files/Gabriel_Isaac_Alonso_Serrato_CV.pdf"
    >CV <span aria-hidden="true">↗</span><span class="sr-only"> (PDF)</span></a
  >
</header>
