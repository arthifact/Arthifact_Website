---
interface Props {
  wide?: boolean;
  placement?: "top" | "bottom";
  layout?: "equal" | "lead";
}
const { wide = true, layout = "equal", placement = "top" } = Astro.props;
---

<div
  class:list={[
    "figure-grid",
    { "paper-wide": wide, "figure-grid-lead": layout === "lead" },
  ]}
  data-paper-placement={wide ? placement : undefined}
>
  <slot />
</div>
