---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata | string;
  alt: string;
  id: string;
  caption?: string;
  number?: number;
  wide?: boolean;
  placement?: "top" | "bottom";
  maxWidth?: number;
  width?: number;
  height?: number;
  sizes?: string;
  captionPosition?: "below" | "side";
}
const {
  src,
  alt,
  id,
  caption,
  number,
  wide = false,
  placement = "top",
  maxWidth,
  width,
  height,
  sizes,
  captionPosition = "below",
} = Astro.props;
if (typeof src === "string" && (!width || !height)) {
  throw new Error(`Figure ${id}: provide width and height for an image URL.`);
}
const original = typeof src === "string" ? src : src.src;
const widths =
  typeof src === "string"
    ? []
    : [
        ...new Set([480, 960, 1440, src.width].filter((w) => w <= src.width)),
      ].sort((a, b) => a - b);
---

<figure
  id={id}
  class:list={[
    "paper-figure",
    { "paper-wide": wide, "paper-figure-side": captionPosition === "side" },
  ]}
  aria-labelledby={`${id}-caption`}
  data-paper-placement={wide ? placement : undefined}
  style={maxWidth ? `--figure-max-width: ${maxWidth}px` : undefined}
>
  <a
    class="figure-image"
    href={original}
    target="_blank"
    rel="noopener"
    aria-label={`Open full-size figure: ${alt}`}
  >
    {
      typeof src === "string" ? (
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={src}
          alt={alt}
          widths={widths}
          sizes={
            sizes ??
            (wide
              ? captionPosition === "side"
                ? "(min-width: 700px) min(635px, calc(58.072vw - 1.5px)), calc(100vw - clamp(40px, 8vw, 96px) - 32px)"
                : `(min-width: 700px) min(${maxWidth ?? 870}px, calc(81.862vw - 2px)), min(${maxWidth ?? 870}px, calc(100vw - clamp(40px, 8vw, 96px) - 32px))`
              : "(min-width: 700px) min(411px, calc(38.678vw - 1px)), calc(100vw - clamp(40px, 8vw, 96px) - 32px)")
          }
          format="webp"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
  <figcaption id={`${id}-caption`}>
    {number !== undefined && <strong>Figure {number}.</strong>}{" "}<slot
      >{caption}</slot
    >
  </figcaption>
</figure>
