---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata | string;
  alt: string;
  id: string;
  caption?: string;
  number?: number;
  wide?: boolean;
  maxWidth?: number;
  width?: number;
  height?: number;
  sizes?: string;
  captionPosition?: "below" | "side";
}
const {
  src,
  alt,
  id,
  caption,
  number,
  wide = true,
  maxWidth,
  width,
  height,
  sizes,
  captionPosition = "below",
} = Astro.props;
if (typeof src === "string" && (!width || !height)) {
  throw new Error(`Figure ${id}: provide width and height for an image URL.`);
}
const original = typeof src === "string" ? src : src.src;
const widths =
  typeof src === "string"
    ? []
    : [
        ...new Set([480, 960, 1440, src.width].filter((w) => w <= src.width)),
      ].sort((a, b) => a - b);
---

<figure
  id={id}
  class:list={[
    "paper-figure",
    { "paper-wide": wide, "paper-figure-side": captionPosition === "side" },
  ]}
  aria-labelledby={`${id}-caption`}
  style={maxWidth ? `--figure-max-width: ${maxWidth}px` : undefined}
>
  <a
    class="figure-image"
    href={original}
    target="_blank"
    rel="noopener"
    aria-label={`Open full-size figure: ${alt}`}
  >
    {
      typeof src === "string" ? (
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={src}
          alt={alt}
          widths={widths}
          sizes={
            sizes ??
            (wide
              ? captionPosition === "side"
                ? "(min-width: 1080px) 635px, (min-width: 940px) calc((100vw - 230px) * 3 / 4), (min-width: 761px) min(488px, calc((100vw - 154px) * 3 / 4)), (min-width: 700px) calc((100vw - 130px) * 3 / 4), calc(100vw - 72px)"
                : `(min-width: 1080px) ${maxWidth ?? 870}px, (min-width: 940px) min(${maxWidth ?? 870}px, calc(100vw - 206px)), (min-width: 761px) min(${maxWidth ?? 674}px, calc(100vw - 130px)), (min-width: 700px) min(${maxWidth ?? 674}px, calc(100vw - 106px)), calc(100vw - 72px)`
              : "(min-width: 1080px) 411px, (min-width: 940px) calc((100vw - 254px) / 2), (min-width: 761px) calc((100vw - 162px) / 2), (min-width: 700px) calc((100vw - 138px) / 2), calc(100vw - 72px)")
          }
          format="webp"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
  <figcaption id={`${id}-caption`}>
    {number !== undefined && <strong>Figure {number}.</strong>}{" "}<slot
      >{caption}</slot
    >
  </figcaption>
</figure>
