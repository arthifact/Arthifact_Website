---
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";
const projects = (
  await getCollection("project", ({ data }) => data.kind === "project")
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<PageLayout
  meta={{
    title: "Projects",
    description:
      "Open-source tools, interactive systems, and graphics experiments by Gabriel I. Alonso.",
  }}
>
  <PageIntro
    number="02"
    title="Projects"
    description="Tools, interactive systems, and experiments. From mathematical visualization to playful worlds."
  />
  <div class="index-topline mono">
    <span>{String(projects.length).padStart(2, "0")} projects</span><a
      href="https://github.com/arthifact">Code on GitHub ↗</a>
  </div>
  <div class="work-grid">
    {
      projects.map((project, index) => (
        <WorkCard project={project} index={index} />
      ))
    }
  </div>
</PageLayout>
