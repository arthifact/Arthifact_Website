---
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";
const research = (
  await getCollection("project", ({ data }) => data.kind === "research")
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<PageLayout
  meta={{
    title: "Research",
    description:
      "Geometry-processing interests and research writing by Gabriel I. Alonso.",
  }}
>
  <PageIntro
    number="01"
    title="Research"
    description="Exploring how we represent, understand, and compute with shape. My research direction is geometry processing, with an interest in differentiable representations and simulation."
  />
  <section class="research-interests" aria-labelledby="interests-title">
    <h2 class="eyebrow" id="interests-title">Areas of interest</h2><ul>
      <li>Geometry processing</li><li>Differentiable representations</li><li>
        Simulation & computer graphics
      </li>
    </ul>
  </section>
  <section aria-labelledby="research-writing-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reading, investigating, sharing</p><h2
          id="research-writing-title"
        >
          Research writing
        </h2>
      </div><span class="mono">SGI 2025</span>
    </div><div class="research-list">
      {
        research.map((project, index) => (
          <WorkCard project={project} index={index} />
        ))
      }
    </div>
  </section>
  <p class="research-context">
    The DMesh++ essay was written with Amruth Srivathsan during the Summer
    Geometry Initiative, under the mentorship of Yi Zhuo at Adobe Research. <a
      class="text-link"
      href="https://summergeometry.org/sgi2025/dmesh/"
      >Read the original essay ↗</a>
  </p>
</PageLayout>
