---
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";
const research = (
  await getCollection("project", ({ data }) => data.kind === "research")
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<PageLayout
  meta={{
    title: "Research",
    description:
      "Research interests and writing by Gabriel I. Alonso, spanning geometry, the environment, and art.",
  }}
>
  <PageIntro
    number="01"
    title="Research"
    description="I’m interested in geometry, the environment, and art. I like understanding how things work and using what I learn in practical projects. My research interests include geometry processing, differentiable representations, simulation, and computer graphics."
  />
  <section aria-labelledby="research-writing-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reading, investigating, sharing</p><h2
          id="research-writing-title"
        >
          Research writing
        </h2>
      </div><span class="mono">SGI 2025</span>
    </div><div class="research-list">
      {
        research.map((project, index) => (
          <WorkCard project={project} index={index} />
        ))
      }
    </div>
  </section>
  <p class="research-context">
    The DMesh++ essay was written with Amruth Srivathsan during the Summer
    Geometry Initiative, under the mentorship of Yi Zhuo at Adobe Research. <a
      class="text-link"
      href="https://summergeometry.org/sgi2025/dmesh/"
      >Read the original essay ↗</a>
  </p>
</PageLayout>
