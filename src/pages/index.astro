---
import { getCollection } from "astro:content";
import Logo from "@/components/Logo.astro";
import OceanStill from "@/components/OceanStill.astro";
import WorkCard from "@/components/WorkCard.astro";
import PageLayout from "@/layouts/Base.astro";

const projects = await getCollection("project");
const selected = [
  {
    id: "article-exploring-dmesh",
    title: "DMesh++",
    description: "Differentiable meshing.",
  },
  {
    id: "cielo-g-framework",
    title: "CIELO-G",
    description: "Learning framework for Godot.",
  },
  {
    id: "lego-utep-dino-animation",
    title: "LEGO animation",
    description: "UTEP · Blender.",
  },
  {
    id: "graph-explorer",
    title: "Graph Explorer",
    description: "Interactive functions in Unity.",
  },
  {
    id: "unreal-voxel-character",
    title: "Voxel character",
    description: "Unreal Engine · interaction.",
  },
  {
    id: "behavioral-deplasticization-animation",
    title: "Deplasticization",
    description: "A short film in Spline.",
  },
].map(({ id, ...copy }) => {
  const project = projects.find((entry) => entry.id === id);
  if (!project) throw new Error(`Selected work is missing: ${id}`);
  return { project, ...copy };
});
---

<PageLayout
  meta={{
    title: "Portfolio",
    description:
      "Gabriel I. Alonso — environmental engineering graduate student. Research, projects, art, and writing.",
  }}
  showFooter={false}
>
  <div class="home-intro">
    <div class="home-identity">
      <div class="home-name">
        <Logo class="home-symbol" />
        <h1>Gabriel I. Alonso<span class="accent-dot">.</span></h1>
      </div>
      <p>Environmental engineering graduate student</p>
      <p class="home-contact">
        <a href="mailto:gialonsoser@gmail.com">gialonsoser@gmail.com</a>
      </p>
    </div>
    <OceanStill />
  </div>
  <section class="selected-section" aria-labelledby="selected-title">
    <h2 id="selected-title" class="eyebrow">Selected work</h2>
    <div class="selected-grid">
      {
        selected.map(({ project, title, description }, index) => (
          <WorkCard
            project={project}
            title={title}
            description={description}
            headingLevel={3}
            loading={index < 3 ? "eager" : "lazy"}
            priority={index === 0}
            imageFit={index < 2 ? "contain" : "cover"}
            imageSizes="(max-width: 600px) calc(50vw - 29px), (max-width: 760px) calc(33.333vw - 27px), (max-width: 1050px) calc(33.333vw - 40px), (max-width: 1336px) calc(33.333vw - 51px), 395px"
          />
        ))
      }
    </div>
  </section>
</PageLayout>
